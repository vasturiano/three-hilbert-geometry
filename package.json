{
  "name": "three-hilbert-geometry",
  "version": "0.1.0",
  "description": "ThreeJS geometry for drawing a Hilbert curve segment",
  "type": "module",
  "unpkg": "dist/three-hilbert-geometry.min.js",
  "main": "dist/three-hilbert-geometry.mjs",
  "module": "dist/three-hilbert-geometry.mjs",
  "types": "dist/three-hilbert-geometry.d.ts",
  "exports": {
    "types": "./dist/three-hilbert-geometry.d.ts",
    "umd": "./dist/three-hilbert-geometry.min.js",
    "default": "./dist/three-hilbert-geometry.mjs"
  },
  "homepage": "https://github.com/vasturiano/three-hilbert-geometry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasturiano/three-hilbert-geometry.git"
  },
  "bugs": {
    "url": "https://github.com/vasturiano/three-hilbert-geometry/issues"
  },
  "license": "MIT",
  "keywords": [
    "3d",
    "three",
    "hilbert",
    "webgl"
  ],
  "author": {
    "name": "Vasco Asturiano",
