    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/three": ">=0.72.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.4",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=12"
  }
